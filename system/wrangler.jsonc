{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiyori-recycle",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "vars": {
    "HIYORI_HOSTING": "cloudflare",
    "HIYORI_EMPLOYEE_NAME": "a",
    "HIYORI_AI_MODEL": "@cf/qwen/qwen2.5-coder-32b-instruct"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiyori-recycle-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "41931001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
